11.Get three inputs in the format-integer, character, integer. The inputs are all separated by spaces. Perform the operation with the integer values based on the character(+,-,*,/). Display the calculated value as the output.
Ex : 23 + 45
o/p : 68
******************************************************************
import java.util.Scanner;
public class Main{
    public static void main(String[] args){
        Scanner dvd=new Scanner(System.in);
       int n1=dvd.nextInt();
       char c=dvd.next().charAt(0);
       int n2=dvd.nextInt();
       if(c=='+')
       System.out.println((n1+n2));
      else if(c=='-')
       System.out.println((n1-n2));
       else if(c=='*')
       System.out.println((n1*n2));
       else if(c=='/')
       System.out.println((n1/n2));
       else
       System.out.println("Invalid character");
    }  
} 
