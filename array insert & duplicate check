import java.util.Scanner;
import java.util.Arrays;

public class Main
{
	public static void main(String[] args) {
		Scanner in=new Scanner(System.in);
		int n=in.nextInt();
		int r=0;
		int flag=0;
		int[] arr=new int[n];
		int[] new_a=new int[n+1];
		for(int i=0;i<n;i++)
		{
		    arr[i]=in.nextInt();
		}
		int t=in.nextInt();
		int v=in.nextInt();
		for(int i=0;i<t-1;i++)
		{
		    new_a[i]=arr[i];
		}
		new_a[t-1]=v;
		for(int i=t-1;i<n;i++)
		{
		    new_a[i+1]=arr[i];
		}
		for(int i=0;i<n;i++)
		{ 
		    if(flag==0)
		    {
		        for(int j=i+1;j<=n;j++)
		            {
		                if(new_a[i]==new_a[j])
		                {
		                    r+=new_a[i];
		                    flag=1;
		                    break;
		                }
		            }
	    	}
		}
		System.out.println(Arrays.toString(new_a));
		if(flag==1)
		{
	    	System.out.println(r);
		}
	}
}
