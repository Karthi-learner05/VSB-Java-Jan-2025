6.Right triangle
import java.util.Scanner;
public class Main
{
	public static void main(String[] args) {
	    Scanner sc=new Scanner(System.in);
	    int limit=sc.nextInt();
	   for(int row=1;row<=limit;row++)
	   {
	   
	   for(int col=1;col<=limit-row;col++)
	   System.out.print(" ");
	   
	   for(int col=1;col<=row;col++)
	   System.out.print("*");
	   
	   System.out.println();
	   }
	}
}


