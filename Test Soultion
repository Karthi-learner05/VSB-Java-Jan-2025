2.Fibonacci Series

import java.util.Scanner;
public class Main{
  public static void main(String args[])
  {
    Scanner sc=new Scanner(System.in);
    int f=1,s=1,t,count;
    count=sc.nextInt();
    System.out.print(f+" "+s);
    for(int i=1;i<=count;i++)
    {
      t=f+s;
      System.out.print(" "+t);
      f=s;
      s=t;
    }
  }
}

3.Perfect cube or not
import java.util.Scanner;
public class Main {

    public static void main(String[] args) {
       Scanner sc=new Scanner(System.in);
       int n,cube;
       n=sc.nextInt();
        for (int i = 1; i <= n; i++) {
            cube = i * i * i;

            if (cube == n) {
                System.out.println("Yes");
                break;
            } else if (cube > n) {
                System.out.println("No");
                break;
            }
        }
      }
}

