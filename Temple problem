import java.util.Scanner;

public class Main
{
	public static void main(String[] args) 
	{
		Scanner in=new Scanner(System.in);
		int n=in.nextInt();
		for (int i=1;i<=n ;i++ )
		{
		    for(int j=1;j<=(n-i);j++)
		    {
		        System.out.print(" ");
		    }
		    for(int j=1;j<=2*i-1;j++)
		    {
		        System.out.print("*");
		    }
		    System.out.println();
		}
		int last=2*n-1;
		for(int i=0;i<=Math.ceil(n/2);i++)
		{
		    for(int j=1;j<=2*n-1;j++)
		    {
		       if(j==1||j==2||j==3||j==last||j==last-1||j==last-2)
		       System.out.print("*");
		       else
		       System.out.print(" ");
		    }
		    System.out.println();
		}
	}
}
